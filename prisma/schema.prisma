// MOMO Email System — Prisma schema (Neon Postgres).
//
// Strapi-forward by design: plural snake_case table names via @@map, standard
// id / created_at / updated_at columns, and JSON columns for structured content
// (blocks, audience, stats). A Strapi v5 backend can later adopt these tables
// directly, or round-trip via `prisma db pull` / `pg_dump`. No Postgres-only
// exotic types are used.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("POSTGRES_PRISMA_URL")
  directUrl = env("DATABASE_URL_UNPOOLED")
}

// ---------------------------------------------------------------------------
// Better Auth (identity + sessions). Better Auth is the permanent owner of
// login; Strapi later consumes this identity, it never re-owns it. Field names
// are the exact names Better Auth's Prisma adapter expects (camelCase); columns
// are @map'd to snake_case to match the rest of the schema and stay
// Strapi-forward. Custom app fields (role/status/onboarding/profile/offers) live
// on the user row so a single query answers "who is this and what can they do".
// ---------------------------------------------------------------------------

model User {
  id            String   @id
  name          String
  email         String   @unique
  emailVerified Boolean  @default(false) @map("email_verified")
  image         String?
  createdAt     DateTime @default(now()) @map("created_at")
  updatedAt     DateTime @updatedAt @map("updated_at")

  // App-specific fields (managed server-side; never settable by the client).
  role             String  @default("customer")
  status           String  @default("active")
  onboardingStatus String  @default("pending") @map("onboarding_status")
  roleOverride     String? @map("role_override")
  profile          Json    @default("{}")
  offers           Json    @default("[]")

  sessions Session[]
  accounts Account[]
  orders   Order[]

  @@map("user")
}

model Session {
  id        String   @id
  expiresAt DateTime @map("expires_at")
  token     String   @unique
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")
  ipAddress String?  @map("ip_address")
  userAgent String?  @map("user_agent")
  userId    String   @map("user_id")
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("session")
}

model Account {
  id                    String    @id
  accountId             String    @map("account_id")
  providerId            String    @map("provider_id")
  userId                String    @map("user_id")
  user                  User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  accessToken           String?   @map("access_token")
  refreshToken          String?   @map("refresh_token")
  idToken               String?   @map("id_token")
  accessTokenExpiresAt  DateTime? @map("access_token_expires_at")
  refreshTokenExpiresAt DateTime? @map("refresh_token_expires_at")
  scope                 String?
  password              String?
  createdAt             DateTime  @default(now()) @map("created_at")
  updatedAt             DateTime  @updatedAt @map("updated_at")

  @@map("account")
}

model Verification {
  id         String   @id
  identifier String
  value      String
  expiresAt  DateTime @map("expires_at")
  createdAt  DateTime @default(now()) @map("created_at")
  updatedAt  DateTime @updatedAt @map("updated_at")

  @@map("verification")
}

/// A customer order. Mirrors the localStorage reference shape 1:1 so the
/// OrdersAdapter port is backend-agnostic. Money is stored in the currency's
/// major units (matching Product.price.amount and the app's JS number model).
/// Line items and applied offers are JSON so the record is self-contained and
/// stays accurate even if the catalog or the customer's offers change later.
model Order {
  id            String   @id
  number        String   @unique
  userId        String   @map("user_id")
  email         String
  status        String   @default("processing") // processing | fulfilled | cancelled | refunded
  items         Json     @default("[]")
  subtotal      Float
  shipping      Float
  discount      Float    @default(0)
  appliedOffers Json     @default("[]") @map("applied_offers")
  // Store-wide code (if any) applied to this order, e.g. "SUMMER20". Kept
  // alongside appliedOffers (which records its monetary effect) so admins can
  // see and filter by which code was used.
  discountCode  String?  @map("discount_code")
  total         Float
  currency      String
  // Set when the order was finalized from a Stripe Checkout Session. Unique so
  // re-delivered webhooks can never create a duplicate order (idempotency key).
  stripeSessionId String? @unique @map("stripe_session_id")
  // PaymentIntent id backing this order's charge — the handle refunds are
  // issued against. Captured at finalizeCheckout; back-filled on demand for
  // orders created before this column existed.
  stripePaymentIntentId String? @map("stripe_payment_intent_id")
  // Running total refunded so far, in the order's major currency unit (matches
  // `total`). Caps further refunds at `total - refundedAmount`.
  refundedAmount Float @default(0) @map("refunded_amount")
  // Append-only audit log: { id, amount, currency, reason, createdAt }[].
  refunds       Json     @default("[]")
  // Shipment tracking, set by the admin once the order ships. `carrier` is one
  // of the known keys in lib/orders/tracking.ts (used to build trackingUrl
  // from trackingNumber) or "other", which requires an admin-supplied URL.
  // `shippedAt` is stamped once on first save and never overwritten, so it
  // marks the actual ship date even if tracking details are corrected later.
  carrier        String?   @map("carrier")
  trackingNumber String?   @map("tracking_number")
  trackingUrl    String?   @map("tracking_url")
  shippedAt      DateTime? @map("shipped_at")
  createdAt     DateTime @default(now()) @map("created_at")
  updatedAt     DateTime @updatedAt @map("updated_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([createdAt])
  @@map("orders")
}

/// A checkout that has been priced and had its stock reserved, but is not yet a
/// real Order — it becomes one only when Stripe confirms payment via webhook.
/// Holds the authoritative priced payload plus the exact stock deltas that were
/// decremented at reservation time, so an abandoned/expired/failed checkout can
/// restore that stock precisely. `status` is the single source of truth for the
/// lifecycle: reserved -> completed (order created) | released (stock restored).
model PendingCheckout {
  id              String   @id
  stripeSessionId String?  @unique @map("stripe_session_id")
  userId          String   @map("user_id")
  email           String
  items           Json     @default("[]")
  appliedOffers   Json     @default("[]") @map("applied_offers")
  // Exact { slug, quantity } deltas removed from stock at reservation time.
  reservedStock   Json     @default("[]") @map("reserved_stock")
  subtotal        Float
  shipping        Float
  discount        Float    @default(0)
  // Store-wide code (if any) validated for this checkout — carried onto the
  // Order at finalization and used to increment DiscountCode.redemptionCount.
  discountCode    String?  @map("discount_code")
  total           Float
  currency        String
  status          String   @default("reserved") // reserved | completed | released
  createdAt       DateTime @default(now()) @map("created_at")
  updatedAt       DateTime @updatedAt @map("updated_at")

  @@index([status])
  @@map("pending_checkouts")
}

/// A store-wide discount code, redeemable by any customer at checkout. Distinct
/// from OfferTag (admin-assigned, per-customer, lives on User.offers) — a code
/// is a single shared string the customer types in at checkout. At checkout a
/// valid code is turned into a synthetic OfferTag and priced through the exact
/// same engine personal offers use (features/checkout/lib/pricing.ts), so the
/// "single best percent offer" / shipping-waiver rules apply identically either
/// way and a code can never stack with a percent offer to exceed 100%.
model DiscountCode {
  id              String    @id @default(uuid())
  code            String    @unique
  label           String
  kind            String    @default("percent") // percent | shipping
  // Percent amount for `percent` codes (0-100). Ignored for `shipping`.
  value           Float?
  active          Boolean   @default(true)
  expiresAt       DateTime? @map("expires_at")
  // Minimum cart subtotal (major currency units) required to use the code.
  minSubtotal     Float?    @map("min_subtotal")
  // Maximum number of orders this code may discount, store-wide. Null = unlimited.
  maxRedemptions  Int?      @map("max_redemptions")
  redemptionCount Int       @default(0) @map("redemption_count")
  createdAt       DateTime  @default(now()) @map("created_at")
  updatedAt       DateTime  @updatedAt @map("updated_at")

  @@map("discount_codes")
}

/// A product review. Not FK-bound to a user because reviews may be submitted by
/// guests (e.g. via the contact form); authorId, when present, is the account id
/// used only to show an author their own still-pending review. Moderation status
/// is authoritative and set server-side — the client never sets it.
model Review {
  id          String   @id
  productSlug String   @map("product_slug")
  authorId    String?  @map("author_id")
  author      String
  avatarUrl   String?  @map("avatar_url")
  rating      Int
  headline    String
  body        String
  status      String   @default("pending") // published | pending | rejected
  source      String   @default("user") // seed | user
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")

  @@index([productSlug])
  @@index([createdAt])
  @@map("reviews")
}

/// Singleton brand/config row (id is always 1). One source of truth for the
/// branding every template and server-side send shares.
model EmailSettings {
  id           Int      @id @default(autoincrement())
  brandName    String   @default("MOMO") @map("brand_name")
  fromName     String   @default("MOMO Audio") @map("from_name")
  supportEmail String   @default("") @map("support_email")
  heroImageUrl String   @default("") @map("hero_image_url")
  accentColor  String   @default("#2dd4bf") @map("accent_color")
  footerText   String   @default("") @map("footer_text")
  footerCities String   @default("London · Copenhagen · Accra · Tokyo") @map("footer_cities")
  address      String   @default("")
  createdAt    DateTime @default(now()) @map("created_at")
  updatedAt    DateTime @updatedAt @map("updated_at")

  @@map("email_settings")
}

/// A block-based email template. `blocks` holds the ordered section/block model
/// as JSON so non-technical staff can add / reorder sections without code.
model EmailTemplate {
  id          Int      @id @default(autoincrement())
  key         String   @unique
  name        String
  category    String   @default("marketing") // transactional | marketing | system
  subject     String   @default("")
  previewText String   @default("") @map("preview_text")
  description String   @default("")
  blocks      Json     @default("[]")
  isSystem    Boolean  @default(false) @map("is_system")
  version     Int      @default(1)
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")

  campaigns Campaign[]
  versions  EmailTemplateVersion[]

  @@map("email_templates")
}

/// Immutable snapshot of a template taken on every save, reset and restore.
/// Powers version history and gives custom templates an "original" to reset to.
model EmailTemplateVersion {
  id          Int      @id @default(autoincrement())
  templateId  Int      @map("template_id")
  version     Int
  name        String
  category    String
  subject     String   @default("")
  previewText String   @default("") @map("preview_text")
  description String   @default("")
  blocks      Json     @default("[]")
  reason      String   @default("save") // create | save | reset | restore | baseline
  createdAt   DateTime @default(now()) @map("created_at")

  template EmailTemplate @relation(fields: [templateId], references: [id], onDelete: Cascade)

  @@unique([templateId, version])
  @@index([templateId, createdAt])
  @@map("email_template_versions")
}

/// Reusable snippet for replying to customers (delivery instructions, next
/// steps, etc.).
model MessagePreset {
  id        Int      @id @default(autoincrement())
  name      String
  category  String   @default("general")
  subject   String   @default("")
  body      String   @default("")
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@map("message_presets")
}

/// Log of an outbound admin -> customer message.
model CustomerMessage {
  id            Int      @id @default(autoincrement())
  customerEmail String   @map("customer_email")
  customerName  String   @default("") @map("customer_name")
  subject       String
  body          String
  presetId      Int?     @map("preset_id")
  replyTo       String   @default("") @map("reply_to")
  resendId      String   @default("") @map("resend_id")
  status        String   @default("sent")
  createdAt     DateTime @default(now()) @map("created_at")

  @@map("customer_messages")
}

/// A marketing campaign built from a template and sent to an audience.
model Campaign {
  id          Int       @id @default(autoincrement())
  name        String
  templateId  Int?      @map("template_id")
  subject     String    @default("")
  previewText String    @default("") @map("preview_text")
  audience    Json      @default("{}")
  status      String    @default("draft") // draft | scheduled | sending | sent
  stats       Json      @default("{}")
  createdAt   DateTime  @default(now()) @map("created_at")
  updatedAt   DateTime  @updatedAt @map("updated_at")
  sentAt      DateTime? @map("sent_at")
  scheduledAt DateTime? @map("scheduled_at")

  template EmailTemplate? @relation(fields: [templateId], references: [id])

  @@map("campaigns")
}

/// Newsletter / marketing audience. Opt-in respected on send.
model Subscriber {
  id        Int      @id @default(autoincrement())
  email     String   @unique
  name      String   @default("")
  optedIn   Boolean  @default(true) @map("opted_in")
  source    String   @default("manual")
  createdAt DateTime @default(now()) @map("created_at")

  @@map("subscribers")
}

/// Unified record of every send (transactional, campaign, customer message)
/// powering the Overview dashboard.
model EmailLog {
  id          Int      @id @default(autoincrement())
  to          String
  subject     String
  templateKey String   @default("") @map("template_key")
  type        String   @default("transactional") // transactional | campaign | message | test
  relatedId   String   @default("") @map("related_id")
  resendId    String   @default("") @map("resend_id")
  status      String   @default("sent") // sent | skipped | failed
  createdAt   DateTime @default(now()) @map("created_at")

  @@map("email_log")
}

/// Admin-managed overlay over the code-authored product seed. Marketing content
/// (hero beats, features, specs) stays in code; this table stores the admin's
/// edits (price, stock, name, etc.), created products, and deletions. At read
/// time the overlay is merged onto the seed (overlay wins; `deleted` tombstones
/// remove a seed product). `data` holds the full effective Product JSON so a
/// row is self-contained; `deleted` rows keep an empty object and are skipped.
model ProductOverlay {
  slug      String   @id
  data      Json     @default("{}")
  deleted   Boolean  @default(false)
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@map("product_overlay")
  }

// Singleton row holding the store's business identity (company profile) and
// operational settings. Replaces the former `admin:company` + `admin:settings`
// localStorage stores so settings persist server-side and survive across
// devices/browsers. Strapi-portable: plain columns + JSON address.
model StoreSettings {
  id                Int      @id @default(autoincrement())
  // Company / legal identity
  companyName       String   @default("") @map("company_name")
  contactPerson     String   @default("") @map("contact_person")
  contactEmail      String   @default("") @map("contact_email")
  supportPhone      String   @default("") @map("support_phone")
  address           Json     @default("{}")
  vatNumber         String   @default("") @map("vat_number")
  industry          String   @default("")
  logoUrl           String?  @map("logo_url")
  onboarded         Boolean  @default(false)
  // Storefront-facing + operational settings
  storeName         String   @default("MOMO Audio") @map("store_name")
  supportEmail      String   @default("admin@adudev.co.uk") @map("support_email")
  currency          String   @default("GBP")
  lowStockThreshold Int      @default(5) @map("low_stock_threshold")
  emailAlerts       Boolean  @default(true) @map("email_alerts")
  // Single source of truth for brand identity (theme template library).
  theme             Json     @default("{}")
  updatedAt         DateTime @updatedAt @map("updated_at")

  @@map("store_settings")
  }
